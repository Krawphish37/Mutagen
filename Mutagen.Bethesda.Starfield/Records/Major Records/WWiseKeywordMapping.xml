<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="WWiseKeywordMapping" recordType="WKMF" objType="Record" baseClass="StarfieldMajorRecord">
    <Fields>
      <Enum name="MappingTemplate" recordType="WMTI" enumName="WWiseKeywordMapping.MappingTemplateType" byteLength="2" />
      <List name="Keywords" recordType="WMKA" >
        <FormLink refName="Keyword" />
      </List>
      <RefList name="Items" refName="WWiseKeywordMappingItem" counterRecType="WMSS" />
    </Fields>
  </Object>
  <Object name="WWiseKeywordMappingItem" objType="Subrecord" >
    <Fields>
      <Enum name="SoundId" recordType="WMSI" enumName="WWiseKeywordMappingItem.SoundIdType" byteLength="2" nullable="False" />
      <RefDirect name="Sound" refName="WWiseKeywordMappingSoundItem" />
    </Fields>
  </Object>
  <Object name="WWiseKeywordMappingSoundItem" objType="Subrecord" recordType="WMSD" >
    <Fields>
      <RefDirect name="Sound" refName="SoundReference" />
      <RefList name="SwitchData" refName="WWiseKeywordMappingSoundItemGuidPair" counterLength="4" />
    </Fields>
  </Object>
  <Object name="WWiseKeywordMappingSoundItemGuidPair" objType="Subrecord" >
    <Fields>
      <Guid name="SwitchGroup" />
      <Guid name="SwitchState" />
    </Fields>
  </Object>
</Loqui>
