<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="Note" recordType="NOTE" objType="Record" baseClass="StarfieldMajorRecord">
    <Fields>
      <RefDirect name="VirtualMachineAdapter" refName="VirtualMachineAdapter" overflowRecordType="XXXX" />
      <RefDirect name="ObjectBounds" refName="ObjectBounds" nullable="False" />
      <Float name="DirtinessScale" recordType="ODTY" nullable="False" />
      <RefList name="Components" refName="AComponent" />
      <RefDirect name="Transforms" refName="Transforms" />
      <String name="Name" recordType="FULL" translated="Normal" />
      <RefDirect name="Model" refName="Model" />
      <RefDirect name="PickupSound" recordType="PUSH" refName="SoundReference" />
      <RefDirect name="DropdownSound" recordType="PDSH" refName="SoundReference" />
      <CustomLogic name="TypeParse" recordType="DNAM" fills="Data" />
      <Data>
        <Fields>
          <UInt32 name="Value" />
          <Float name="Weight" />
        </Fields>
      </Data>
      <CustomLogic name="DataParse" fills="Data.Scene,Data.Terminal,Data.File">
        <RecordType>SNAM</RecordType>
        <RecordType>PNAM</RecordType>
      </CustomLogic>
      <RefDirect name="Data" refName="ANoteData" binary="NoGeneration" selectedBy="subrecord:DNAM:UInt8" />
    </Fields>
  </Object>
  <Object name="ANoteData" objType="Subrecord" abstract="true" />
  <Object name="NoteSound" objType="Subrecord" baseClass="ANoteData" selectorValue="Sound">
    <Fields>
      <!-- xEdit: SNAM FormID to SNDR. Starfield has no SNDR records, so the link is untyped. -->
      <FormLink name="Sound" refName="StarfieldMajorRecord" nullable="True" />
    </Fields>
  </Object>
  <Object name="NoteVoice" objType="Subrecord" baseClass="ANoteData" selectorValue="Voice">
    <Fields>
      <FormLink name="Scene" refName="Scene" nullable="True" />
    </Fields>
  </Object>
  <Object name="NoteProgram" objType="Subrecord" baseClass="ANoteData" selectorValue="Program">
    <Fields>
      <!-- xEdit: SNAM is unused (4 bytes) for a Program note; kept as read. Read and written in Note.cs. -->
      <ByteArray name="Unknown" nullable="True" binary="NoGeneration" />
      <String name="File" nullable="True" />
    </Fields>
  </Object>
  <Object name="NoteTerminal" objType="Subrecord" baseClass="ANoteData" selectorValue="Terminal">
    <Fields>
      <FormLink name="Terminal" refName="Terminal" nullable="True" />
    </Fields>
  </Object>
</Loqui>
