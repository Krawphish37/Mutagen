<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="GameSetting" recordType="GMST" baseClass="StarfieldMajorRecord" objType="Record" abstract="true">
    <Fields>
      <Enum name="XalgFlags" enumName="XalgFlag" recordType="XALG" byteLength="8" />
    </Fields>
    <HandWritten name="SettingType" type="GameSettingType" from="class" note="the class, picked from the EDID prefix" />
  </Object>
  <Object name="GameSettingInt" recordType="GMST" baseClass="GameSetting" objType="Record">
    <Fields>
      <Int32 name="Data" recordType="DATA" />
    </Fields>
    <HandWritten name="RawData" type="Single?" from="Data" note="Data as a float" />
  </Object>
  <Object name="GameSettingFloat" recordType="GMST" baseClass="GameSetting" objType="Record">
    <Fields>
      <Float name="Data" recordType="DATA" />
    </Fields>
  </Object>
  <Object name="GameSettingString" recordType="GMST" baseClass="GameSetting" objType="Record">
    <Fields>
      <String name="Data" recordType="DATA" translated="Normal" />
    </Fields>
  </Object>
  <Object name="GameSettingBool" recordType="GMST" baseClass="GameSetting" objType="Record">
    <Fields>
      <Bool name="Data" recordType="DATA" binary="Custom" fills="Data" layoutEncoding="uint32!=0" />
    </Fields>
  </Object>
  <Object name="GameSettingUInt" recordType="GMST" baseClass="GameSetting" objType="Record">
    <Fields>
      <UInt32 name="Data" recordType="DATA" />
    </Fields>
    <HandWritten name="RawData" type="Single?" from="Data" note="Data as a float" />
  </Object>
</Loqui>
