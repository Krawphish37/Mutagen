<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="SurfaceTree" recordType="SFTR" objType="Record" baseClass="StarfieldMajorRecord">
    <Fields>
      <RefList name="Components" refName="AComponent" />
      <!-- The two FNAM grids and the two GNAM blocks are told apart only by their order.
           SurfacePatterns2 written without SurfacePatterns reads back as SurfacePatterns,
           and GNAM2 written without SurfacePatterns2 reads back as GNAM. -->
      <UInt32 name="CNAM" recordType="CNAM" unknown="true" />
      <UInt32 name="EdgeSize" recordType="DNAM" />
      <Array name="SurfacePatterns" recordType="FNAM" overflowRecordType="XXXX" fixedSize="65536" >
        <FormLink refName="SurfacePattern" />
      </Array>
      <ByteArray name="GNAM" recordType="GNAM" unknown="true" overflowRecordType="XXXX" fixedSize="65536"/>
      <Array name="SurfacePatterns2" recordType="FNAM" overflowRecordType="XXXX" fixedSize="65536" >
        <FormLink refName="SurfacePattern" />
      </Array>
      <ByteArray name="GNAM2" recordType="GNAM" unknown="true" overflowRecordType="XXXX" fixedSize="65536"/>
      <String name="Filter" recordType="NAM1" />
    </Fields>
  </Object>
</Loqui>
