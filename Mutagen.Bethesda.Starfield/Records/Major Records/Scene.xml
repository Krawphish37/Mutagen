      <ByteArray name="SPMV" recordType="SPMV" unknown="true" />
      <Marker name="EndMarker" recordType="HNAM" />
    </Fields>
  </Object>
  <Object name="SceneActor" objType="Subrecord">
    <Fields>
      <UInt32 name="ID" recordType="ALID" nullable="False" />
