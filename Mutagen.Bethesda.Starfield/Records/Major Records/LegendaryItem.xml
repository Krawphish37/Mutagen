<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="LegendaryItem" recordType="LGDI" objType="Record" baseClass="StarfieldMajorRecord">
    <Fields>
      <RefDirect name="VirtualMachineAdapter" refName="VirtualMachineAdapter" overflowRecordType="XXXX" />
      <RefDirect name="ObjectBounds" refName="ObjectBounds" />
      <Float name="DirtinessScale" recordType="ODTY" nullable="False" />
      <Enum name="LightLayer" enumName="Light.LightLayer" byteLength="4" recordType="FLLD" />
      <String name="Name" recordType="FULL" translated="Normal" />
      <RefDirect name="ObjectPaletteDefaults" refName="ObjectPaletteDefaults" />
      <RefDirect name="Transforms" refName="Transforms" />
      <Enum name="XalgFlags" enumName="XalgFlag" recordType="XALG" byteLength="8" />
      <RefList name="Components" refName="AComponent" />
      <RefDirect name="Model" refName="Model" />
      <Marker name="DATA" recordType="DATA" />
      <FormLink name="BaseObjectList" refName="LeveledItem" recordType="ANAM" />
      <FormLink name="RankTemplate" refName="LegendaryItem" recordType="ENAM" />
      <FormLink name="AddIntoLegendary" refName="LegendaryItem" recordType="MNAM" />
      <RefList name="LegendaryMods" refName="LegendaryMod" recordType="BNAM" />
      <RefList name="LnamEntries" refName="LegendaryItemLnamEntry" recordType="LNAM" binary="Custom" />
      <RefList name="IncludeFilters" refName="LegendaryFilter" recordType="CNAM" />
      <RefList name="ExcludeFilters" refName="LegendaryFilter" recordType="DNAM" />
      <RefList name="RerollCosts" refName="LegendaryItemRankCost" recordType="FNAM" />
      <RefList name="PickCosts" refName="LegendaryItemRankCost" recordType="KNAM" />
      <RefList name="QualityMods" refName="LegendaryMod" recordType="GNAM" />
      <RefList name="QualityAllowedKeywords" refName="LegendaryItemHNAMEntry" recordType="HNAM" />
      <RefList name="QualityDisallowedKeywords" refName="LegendaryItemHNAMEntry" recordType="INAM" />
      <RefList name="QualityUpgradeCosts" refName="LegendaryItemQualityCost" recordType="JNAM" />
    </Fields>
    <LinkInterface>IItem</LinkInterface>
    <LinkInterface>IBaseObject</LinkInterface>
    <LinkInterface>IPlaceableObject</LinkInterface>
    <LinkInterface>IExplodeSpawn</LinkInterface>
    <!-- CITC/CTDA/CIS1/CIS2 consumed by ConditionalEntries custom binary handler -->
    <AdditionalContainedRecordType>CITC</AdditionalContainedRecordType>
    <AdditionalContainedRecordType>CTDA</AdditionalContainedRecordType>
    <AdditionalContainedRecordType>CIS1</AdditionalContainedRecordType>
    <AdditionalContainedRecordType>CIS2</AdditionalContainedRecordType>
  </Object>
  <Object name="LegendaryItemLnamEntry" objType="Subrecord">
    <Fields>
      <Enum name="Slot" enumName="LegendaryItem.StarSlot" />
      <UInt32 name="ReferenceMod" />
      <RefList name="Conditions" refName="Condition" counterRecType="CITC" />
    </Fields>
  </Object>
  <Object name="LegendaryMod" objType="Subrecord">
    <Fields>
      <Enum name="Slot" enumName="LegendaryItem.StarSlot" />
      <FormLink name="ObjectMod" refName="AObjectModification" />
    </Fields>
  </Object>
  <Object name="LegendaryItemRankCost" objType="Subrecord">
    <Fields>
      <Enum name="Rank" enumName="LegendaryItem.StarSlot" />
      <UInt32 name="Count" />
      <FormLink name="Item">
        <Interface>IItem</Interface>
      </FormLink>
    </Fields>
  </Object>
  <Object name="LegendaryItemQualityCost" objType="Subrecord">
    <Fields>
      <UInt32 name="Tier" />
      <UInt32 name="Count" />
      <FormLink name="Item">
        <Interface>IItem</Interface>
      </FormLink>
    </Fields>
  </Object>
  <Object name="LegendaryItemHNAMEntry" objType="Subrecord">
    <Fields>
      <UInt32 name="Tier" />
      <UInt32 name="ReferencedModIndex" />
      <FormLink name="Keyword" refName="Keyword" />
    </Fields>
  </Object>
  <Object name="LegendaryFilter" objType="Subrecord">
    <Fields>
      <Enum name="Slot" enumName="LegendaryItem.StarSlot" />
      <UInt32 name="ReferencedModIndex" />
      <FormLink name="Keyword" refName="Keyword" />
    </Fields>
  </Object>
</Loqui>
