<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <!-- Layout attributes (read by tools describing the bytes, ignored by the generator): layoutOffset = byte offset in the
       subrecord's content; layoutBits = the bits of that byte ("5-7", or one bit); conditionFunction = the CTDA function
       index (UInt16 at offset 8) that selects a ConditionData object, whose own fields start at the Data offset (12).
       CTDA: 0 operator/flags, 1-3 Unused1, 4-7 comparison value, 8-9 function index, 10-11 Unused2, 12-19 parameters
       1 and 2, 20-23 run on, 24-27 reference, 28-31 parameter 3. -->
  <Object name="Condition" objType="Subrecord" abstract="true" recordType="CTDA">
    <Fields>
      <Enum name="CompareOperator" enumName="CompareOperator" binary="NoGeneration" layoutOffset="0" layoutBits="5-7" />
      <Enum name="Flags" enumName="Condition.Flag" binary="Custom" byteLength="1" layoutOffset="0" layoutBits="0-4" />
      <ByteArray name="Unused1" byteLength="3" nullable="False" />
      <CustomLogic name="FunctionParse" />
      <UInt16 name="Unused2" binary="NoGeneration" />
      <RefDirect name="Data" binary="NoGeneration" refName="ConditionData" generateClassMembers="false" layoutOffset="12" />
    </Fields>
    <AdditionalContainedRecordType>CITC</AdditionalContainedRecordType>
    <AdditionalContainedRecordType>CIS1</AdditionalContainedRecordType>
    <AdditionalContainedRecordType>CIS2</AdditionalContainedRecordType>
  </Object>
  <Object name="ConditionGlobal" objType="Subrecord" baseClass="Condition" recordType="CTDA" customBinaryEnd="Normal">
    <Fields>
      <FormLink name="ComparisonValue" refName="Global" binary="NoGeneration" />
    </Fields>
  </Object>
  <Object name="ConditionFloat" objType="Subrecord" baseClass="Condition" recordType="CTDA" customBinaryEnd="Normal">
    <Fields>
      <Float name="ComparisonValue" binary="NoGeneration" />
    </Fields>
  </Object>
</Loqui>
